# Persistent Agent Native database (production must use a durable path/provider)
# DATABASE_URL=file:/var/lib/shipwright/agent-native.db

# Stable session signing secret (32+ random characters in production)
# BETTER_AUTH_SECRET=

# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true

# Deterministic dry-run UI smoke; never publishes.
# SHIPWRIGHT_UI_DEMO=1
