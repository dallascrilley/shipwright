{
  "name": "shipwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "doctor": "tsx scripts/doctor.ts",
    "dev": "cd ui && pnpm dev",
    "build": "cd ui && pnpm build",
    "start": "cd ui && pnpm start",
    "verify": "bun test && bun run typecheck && cd ui && pnpm test && pnpm typecheck && pnpm build",
    "server": "tsx server.ts",
    "client": "tsx client.ts",
    "shipwright": "tsx shipwright.ts",
    "review-agent": "tsx review-agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:docker": "RUN_DOCKER_E2E=1 bun test test/sandbox/docker.e2e.test.ts",
    "test:local-pi": "RUN_LOCAL_PI_E2E=1 bun test test/shipwright-local.e2e.test.ts",
    "test:live": "bun test test/shipwright-live.e2e.test.ts",
    "test:e2e": "AGENTOS_E2E=1 node --import tsx --test test/e2e.test.ts"
  },
  "dependencies": {
    "@agentos-software/pi": "0.2.7",
    "@mariozechner/pi-coding-agent": "0.60.0",
    "@octokit/app": "16.1.2",
    "@octokit/rest": "22.0.1",
    "@rivet-dev/agentos": "0.2.7",
    "@rivet-dev/agentos-core": "0.2.7",
    "dockerode": "^5.0.1",
    "get-port": "^7.2.0",
    "sandbox-agent": "0.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@types/bun": "^1.3.14",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.0.0",
    "tsx": "4.23.1",
    "typescript": "^5.9.0"
  },
  "patchedDependencies": {
    "@rivet-dev/agentos-core@0.2.7": "patches/@rivet-dev%2Fagentos-core@0.2.7.patch"
  }
}
