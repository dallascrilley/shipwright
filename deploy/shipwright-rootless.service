[Unit]
Description=Shipwright GitHub issue operator
After=shipwright-docker.service network-online.target
Wants=network-online.target
Requires=shipwright-docker.service

[Service]
Type=simple
User=shipwright
Group=shipwright
WorkingDirectory=/opt/shipwright/current/ui
Environment=NODE_ENV=production
EnvironmentFile=/etc/shipwright/shipwright.env
ExecStart=/usr/local/bin/mise exec -- pnpm start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shipwright /tmp
BindReadOnlyPaths=/run/user/%%SHIPWRIGHT_UID%%/docker.sock:/var/run/docker.sock
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
