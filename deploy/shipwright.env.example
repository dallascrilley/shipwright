HOST=127.0.0.1
PORT=4317

# rootful is for a dedicated VM. Use rootless on a shared host so Shipwright
# cannot control the host Docker daemon or another user's rootless daemon.
SHIPWRIGHT_DOCKER_MODE=rootful

# Optional public HTTPS edge. Leave empty for Tailscale-only access.
# When set to a DNS name (A/AAAA record -> VM public IP), deploy installs and
# configures Caddy to terminate Let's Encrypt TLS and reverse-proxy to the
# loopback service. Open cloud firewall 80 + 443 before the first deploy.
SHIPWRIGHT_PUBLIC_HOST=
DATABASE_URL=file:/var/lib/shipwright/agent-native.db
SHIPWRIGHT_STATE_DIR=/var/lib/shipwright
# U6 rollout stage: disabled | test_only | dry_run | approval_required | publish_allowed
# Default (unset) is disabled: no scheduler or queue worker runs.
# Advance one stage at a time; see docs/deployment.md "Staged rollout".
SHIPWRIGHT_ROLLOUT_STAGE=disabled
SHIPWRIGHT_SANDBOX_IMAGE=rivetdev/sandbox-agent@sha256:640cfb725a94b8a47967e0c2ec153d3ab267244f517f700e8f82f1e4d55b2ea2
# Optional override; deploy provisions the default under /var/lib/shipwright.
# SHIPWRIGHT_SANDBOX_BUN_PATH=/var/lib/shipwright/.shipwright/tools/bun-1.3.14-linux

BETTER_AUTH_SECRET=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/shipwright/github-app.pem
GITHUB_APP_INSTALLATION_ID=
# Comma-separated exact owner/repo entries and/or owner/* owner scopes.
GITHUB_REPOSITORY_ALLOWLIST=OWNER/REPO,OWNER/*
# Shipwright App trust: issues, pull request reviews, and issue comments only.
GITHUB_WEBHOOK_SECRET=
# Symphony reviewer App trust: pull requests and check suites only.
SYMPHONY_REVIEWER_GITHUB_APP_INSTALLATION_ID=
SYMPHONY_REVIEWER_GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_BOT_LOGIN=
GITHUB_REVIEW_BOT_USER_ID=
# Optional private Symphony receiver. Leave unset to disable the relay.
# SHIPWRIGHT_SYMPHONY_WEBHOOK_URL=http://127.0.0.1:11100/webhooks/github
# Optional all-or-none typed review-command boundary. Never reuse either App secret.
# SHIPWRIGHT_REVIEW_COMMAND_REPOSITORY=OWNER/REPO
# SHIPWRIGHT_REVIEW_OPERATOR_LOGIN=OPERATOR_LOGIN
# SHIPWRIGHT_REVIEW_OPERATOR_USER_ID=OPERATOR_USER_ID
# SHIPWRIGHT_SYMPHONY_REVIEW_REQUEST_URL=http://127.0.0.1:11100/api/v1/review-requests
# SHIPWRIGHT_SYMPHONY_REVIEW_REQUEST_SECRET=

KIMI_API_KEY=
AGENTOS_PROVIDER=kimi
AGENTOS_MODEL=k3
# Optional single retry for provider quota, rate-limit, or capacity failures.
AGENTOS_CODEX_AUTH_FILE=/var/lib/shipwright/codex-auth.json
AGENTOS_FALLBACK_PROVIDER=openai-codex
AGENTOS_FALLBACK_MODEL=gpt-5.4
