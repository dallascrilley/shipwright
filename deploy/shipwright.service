[Unit]
Description=Shipwright GitHub issue operator
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=shipwright
Group=shipwright
SupplementaryGroups=docker
WorkingDirectory=/opt/shipwright/current/ui
Environment=NODE_ENV=production
EnvironmentFile=/etc/shipwright/shipwright.env
ExecStart=/usr/local/bin/mise exec -- pnpm start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shipwright /tmp
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
