# Model provider (configure one; optionally select it with AGENTOS_PROVIDER)
ANTHROPIC_API_KEY=
# AGENTOS_PROVIDER=anthropic
# AGENTOS_MODEL=claude-opus-4-6
# KIMI_API_KEY=
# AGENTOS_PROVIDER=kimi
# AGENTOS_MODEL=k3

# GitHub App identity and selected-repository installation
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem
# GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY_ALLOWLIST=dallascrilley/disposable-programming-agent-test

# Opt-in live acceptance test only
# PROGRAMMING_AGENT_TEST_ISSUE_URL=https://github.com/dallascrilley/disposable-programming-agent-test/issues/1
# PROGRAMMING_AGENT_TEST_VERIFY=npm test
# PROGRAMMING_AGENT_LIVE_PUBLISH=1
