# Shipwright sandbox coding engine (writes the PRs; runs in the sandbox image).
# Configure one primary provider; optionally select it with AGENTOS_PROVIDER.
ANTHROPIC_API_KEY=
# AGENTOS_PROVIDER=anthropic
# AGENTOS_MODEL=claude-opus-4-6
# KIMI_API_KEY=
# AGENTOS_PROVIDER=kimi
# AGENTOS_MODEL=k3
# Optional single retry for provider quota, rate-limit, or capacity failures.
# Ordinary agent, verification, policy, and publish failures never fall back.
# AGENTOS_CODEX_AUTH_FILE=/absolute/path/to/codex-auth.json
# AGENTOS_FALLBACK_PROVIDER=openai-codex
# AGENTOS_FALLBACK_MODEL=gpt-5.4

# In-app chat assistant (the operator console chat / Settings > Models). This is
# a SEPARATE, in-process engine from the sandbox coding engine above and does
# NOT read AGENTOS_PROVIDER. ui/server/plugins/agent-chat.ts pins the engine to
# ai-sdk:openrouter with an auto-router over anthropic/openai/google/z-ai models.
# Set AGENT_ENGINE so the framework's global default matches, and supply an
# OpenRouter key. Leave OPENROUTER_API_KEY unset to disable the in-app assistant.
AGENT_ENGINE=ai-sdk:openrouter
OPENROUTER_API_KEY=
# Optional: pin a specific model instead of the auto-router.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# GitHub App identity. Installation access remains the upper authorization bound.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem
# GITHUB_APP_INSTALLATION_ID=
# Comma-separated exact owner/repo entries and/or owner/* owner scopes.
GITHUB_REPOSITORY_ALLOWLIST=OWNER/REPO,OWNER/*
GITHUB_WEBHOOK_SECRET=
# Separate Symphony reviewer App trust: pull requests and check suites only.
SYMPHONY_REVIEWER_GITHUB_APP_INSTALLATION_ID=
SYMPHONY_REVIEWER_GITHUB_WEBHOOK_SECRET=
# Optional private Symphony receiver. Leave unset to disable the relay.
# SHIPWRIGHT_SYMPHONY_WEBHOOK_URL=http://127.0.0.1:11100/webhooks/github
# Optional all-or-none typed review-command boundary. Never reuse either App secret.
# SHIPWRIGHT_REVIEW_COMMAND_REPOSITORY=OWNER/REPO
# SHIPWRIGHT_REVIEW_OPERATOR_LOGIN=OPERATOR_LOGIN
# SHIPWRIGHT_REVIEW_OPERATOR_USER_ID=OPERATOR_USER_ID
# SHIPWRIGHT_SYMPHONY_REVIEW_REQUEST_URL=http://127.0.0.1:11100/api/v1/review-requests
# SHIPWRIGHT_SYMPHONY_REVIEW_REQUEST_SECRET=

# Durable local receipts and operator-run state
SHIPWRIGHT_STATE_DIR=.artifacts/shipwright
SHIPWRIGHT_SANDBOX_IMAGE=rivetdev/sandbox-agent@sha256:640cfb725a94b8a47967e0c2ec153d3ab267244f517f700e8f82f1e4d55b2ea2

# Opt-in live acceptance test only
# SHIPWRIGHT_TEST_ISSUE_URL=https://github.com/dallascrilley/shipwright/issues/1
# SHIPWRIGHT_TEST_VERIFY=bun test
# SHIPWRIGHT_LIVE_PUBLISH=1

# Host readiness (get-host-readiness) checks configuration presence only.
# It never returns secret values. Docker uses DOCKER_HOST unix socket path when set.
# SHIPWRIGHT_UI_DEMO=1 marks readiness as demo/advisory.

# Optional non-secret verification preset overlays (JSON array).
# Each entry: { "id", "label", "command", "repositories"?: ["owner/repo"], "repositoryGlobs"?: ["owner/*"] }
# Invalid JSON/shape/commands fail closed at module startup (no silent fallback).
# SHIPWRIGHT_VERIFY_PRESETS_JSON=[{"id":"pytest","label":"pytest","command":"pytest -q","repositoryGlobs":["acme/*"]}]
