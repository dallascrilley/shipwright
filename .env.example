# Shipwright model provider (configure one; optionally select it with AGENTOS_PROVIDER)
ANTHROPIC_API_KEY=
# AGENTOS_PROVIDER=anthropic
# AGENTOS_MODEL=claude-opus-4-6
# KIMI_API_KEY=
# AGENTOS_PROVIDER=kimi
# AGENTOS_MODEL=k3

# GitHub App identity and selected-repository installation
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem
# GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY_ALLOWLIST=dallascrilley/shipwright

# Durable local receipts and operator-run state
SHIPWRIGHT_STATE_DIR=.artifacts/shipwright
SHIPWRIGHT_SANDBOX_IMAGE=rivetdev/sandbox-agent:0.5.0-rc.2-full

# Opt-in live acceptance test only
# SHIPWRIGHT_TEST_ISSUE_URL=https://github.com/dallascrilley/shipwright/issues/1
# SHIPWRIGHT_TEST_VERIFY=bun test
# SHIPWRIGHT_LIVE_PUBLISH=1
